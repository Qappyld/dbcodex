TableGroup "PM" [color: #1E69FD] {
  "Personne Morale" 
  Société
}

TableGroup "PP" [color: #00ff00] {
  "Personne Physique"
  Contact
}


TableGroup "CRM" [color: #aa00aa] {
  "Mission"
  "Cabinet" 
}
//////////////////////////////////////////////////////////////
// ENUMS (Option Sets Dataverse)
//////////////////////////////////////////////////////////////

Enum OS_ComportementRisqueClient {
  "Au début ou au cours de la relation d'affaires, versements ou retraits fréquents en cash"
  "Nombre important de transferts entrant ou sortant sans raison apparente"
  "Société intégrée dans une structure / groupe complexe"
  "Demande du client (PP) d'utiliser le compte du client PM sans motif clair apparent"
  "Utilisation de prêts back to back sans raison apparente"
  "Procédure judiciaire à l'encontre de la société"
  "Informations insuffisantes sur le financement de la société"
  "Financement de la structure par contribution personnelle du BO"
  "Financement de la structure par son activité propre"
  "Financement de la structure par financement bancaire (Monaco/UE/UK/Suisse/juridiction réputée équivalente)"
  "Financement de la structure par financement bancaire (pays sensible ou ETHR)"
  "POA illimité sur compte bancaire / signature individuelle du BO"
  "Signature conjointe avec le BO"
  "Tiers mandataire seul sur le compte"
  "La société n'est pas en règle avec son administration fiscale nationale"
}

Enum OS_Type_Client
{
  "Personne Physique"
    "Personne Morale"
}

Enum OS_OwnershipRole {
  "Propriétaire bénéficiaire"
  "Directeur"
  "Juridique"
  "Représentant"
  "Actionnaire"
  "Bénéficiaire effectif ultime"
  "Signataire"
  "Administrateur"
  "Autre"
}

Enum OS_CycleDeVie {
  Prospect
  "Prospect sans suite"
  Actif
  "Relation terminée"
}

Enum OS_Titre {
  M
  Mme
  Mlle
  Dr
  Pr
}

Enum OS_Sexe {
  Homme
  Femme
  Autre
}

Enum OS_EntreeEnRelation {
  "Client direct"
  "Apporteur référencé"
  "Apporteur non référencé"
  "Recommandation interne"
}

Enum OS_Mission {
  "Tenue Comptable"
  "Révision"
  "Audit"
  "Visa"
  "Social"
  "Juridique"
  "Fiscal"
  "Commissariat aux comptes"
  "Mandataire agréé 1,381"
  "Mandataire conservation des données"
  "Advisory LCB/FT-P-C"
  "Advisory Protection des données"
  "RIE & IBE"
}

Enum OS_TypeMission {
  "Récurrente"
  "Occasionnelle"
}

Enum OS_TypeTelephone {
  Personnel
  Domicile
  Professionnel
  Autre
}

Enum OS_TypeEmail {
  Personnel
  Professionnel
  Autre
}

Enum OS_FormeJuridique {
  "SARL"
  "SAS"
  "SA"
  "SASU"
  "EURL"
  "SNC"
  "Association"
  "Fondation"
  "Autre"
}

Enum OS_SecteurActivite {
  "Commerce"
